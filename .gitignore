# dependencies
node_modules/
**/node_modules/

# secrets - never commit
.env
.env.*
!.env.example

# runtime data (SQLite lives on the host's persistent disk in production)
data/
*.db
*.db-shm
*.db-wal
*.sqlite

# logs / pids
logs/
*.log
*.pid

# large generated files (test screenshots, mockup-vs-built comparisons)
screenshots/

# OS / editor
.DS_Store
.vscode/
.idea/

# v5 raw asset downloads (sources + licenses recorded in CREDITS.md and assets-src/meta_*.json)
assets-src/*.jpg
assets-src/*.png
assets-src/*.zip
assets-src/kenney_racing/
assets-src/v6/
