# Copy to .env for local development. On Deplexo/Render/Docker set these as environment variables instead.
PORT=8787
ADMIN_PASSWORD=change-me-to-a-long-random-password
# One secret is enough; session/run-token secrets and the IP-hash salt are derived from it.
SECRET=generate-with-openssl-rand-base64-32
# v7 admin: the panel lives ONLY at /<ADMIN_PATH>/ (16-128 chars of A-Z a-z 0-9 _ -; e.g. `openssl rand -hex 16`). /admin is a 404.
ADMIN_PATH=change-me-to-a-long-random-slug
# ADMIN_USERNAME=owner         # owner account name (signs in with ADMIN_PASSWORD, then enrols an authenticator app)
# TRUST_PROXY_HOPS=1          # default: one ingress hop in production, zero in development; adjust to the hosting network
# TRUST_CF_IP=1                # additionally honor CF-Connecting-IP only when Cloudflare is the trusted front proxy; otherwise leave unset
# ADMIN_RESET_TOKEN=           # owner lockout recovery only (>= 24 chars, works once at /<ADMIN_PATH>/reset); remove after use. See FINALIZE.md
# Public address for share/referral/Open Graph links + <link rel=canonical> (default: the request's own host). See FINALIZE.md
# PUBLIC_URL=https://traptechgaminghub.com
# CANONICAL_REDIRECT=1         # 301 other hostnames to PUBLIC_URL (only when PUBLIC_URL is served by this app directly)
# Optional: where the SQLite file lives (default ./data). Deplexo/Render persistent volume: /data.
# DATA_DIR=/data
# Optional: explicit full path instead of DATA_DIR
# DB_PATH=/data/hub.db

# ---- Low-memory tuning (defaults shown; see DEPLOY-DEPLEXO.md) ----
# BUILD_DIR=./build            # output of `node scripts/deplexo-prebuild.js` (pre-gzipped assets, pre-scaled OG art)
# OG_CACHE_MAX_MB=30           # disk cache for generated share images ($DATA_DIR/og-cache)
# SQLITE_CACHE_KB=2048         # SQLite page cache
# RATE_LIMIT_MAX_KEYS=20000    # LRU cap for the in-memory rate-limit table
# RUN_TOKEN_KEEP_DAYS=3        # delete used/expired run tokens older than this (0 = keep forever)
# NODE_OPTIONS=                # extra node flags (the Docker CMD already sets --max-old-space-size=64 --max-semi-space-size=1)

# ---- Backups ($DATA_DIR/backups, daily + admin "Back up now" / "Download backup") ----
# BACKUP_KEEP=5                # local gzip snapshots kept
# BACKUP_MAX_MB=75             # ... and at most this much disk for them
# BACKUP_INTERVAL_HOURS=24
# BACKUP_DISABLE=1             # turn the automatic schedule off
# Optional off-site copy to a PRIVATE GitHub repo (fine-grained token, that repo only, Contents: read & write):
# BACKUP_GITHUB_TOKEN=github_pat_...
# BACKUP_GITHUB_REPO=TheTavern001/gaming-hub-backups
# BACKUP_GITHUB_BRANCH=backups
# BACKUP_GITHUB_KEEP=5

# v7: Bitcoin checkout (public receiving address, not a secret). Leave empty to keep checkout off.
BTC_ADDRESS=
# Optional overrides (defaults: https://mempool.space/api and its price endpoint)
# BTC_EXPLORER_URL=
# BTC_PRICE_URL=
# PUBLIC_URL=https://your-domain
# ---- Hosted card checkout (optional; disabled unless explicitly configured) ----
# IMPORTANT: Stripe's policy restricts skill-game competitions with material prizes, sweepstakes and some marijuana-related
# business models. Do not process live payments until Stripe confirms in writing that it approves this exact business model.
# Test mode is for technical QA only. The global Admin > Store & orders switch must also be enabled before checkout works.
# Webhook endpoint: https://YOUR_DOMAIN/api/store/webhook/stripe
# Subscribe to checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired, and charge.refunded.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CHECKOUT_ENABLED=0
# STRIPE_LIVE_CHECKOUT_ENABLED=0  # set to 1 ONLY after Stripe's written approval and successful end-to-end test mode QA
# PUBLIC_URL must be the exact HTTPS origin (no path, query, or fragment) used for hosted checkout return URLs.


# ---- Optional Cloudflare R2 media storage (uploaded admin artwork moves off the app disk) ----
# Create an R2 bucket and an R2 S3 API token with Object Read + Object Write for that bucket only.
# Never use your global Cloudflare API token here.
# CLOUDFLARE_R2_ACCOUNT_ID=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET=
# Optional public bucket custom domain (HTTPS); leave unset to serve objects through the Hub.
# CLOUDFLARE_R2_PUBLIC_URL=https://media.your-domain.com
